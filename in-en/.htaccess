DirectoryIndex index.html
Options -MultiViews

RewriteEngine On

# Keep page URLs canonical so relative links do not resolve under /platform/.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Explicit page routes for cPanel/Apache static hosting.
RewriteRule ^$ index.html [L]
RewriteRule ^index/?$ index.html [L]
RewriteRule ^contact/?$ contact.html [L]
RewriteRule ^platform/?$ platform.html [L]
RewriteRule ^solutions/?$ solutions.html [L]
RewriteRule ^about/?$ about.html [L]
RewriteRule ^aacts-3000/?$ aacts-3000.html [L]
RewriteRule ^aviation/?$ aviation.html [L]
RewriteRule ^border-customs/?$ border-customs.html [L]
RewriteRule ^careers/?$ careers.html [L]
RewriteRule ^defense/?$ defense.html [L]
RewriteRule ^forensics/?$ forensics.html [L]
RewriteRule ^healthcare/?$ healthcare.html [L]
RewriteRule ^industrial/?$ industrial.html [L]
RewriteRule ^intelligence/?$ intelligence.html [L]
RewriteRule ^manufacturing/?$ manufacturing.html [L]

# Allow clean URLs such as /platform to load platform.html.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
